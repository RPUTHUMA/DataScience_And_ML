    "from flask import Flask     \n",
    "app = Flask(__name__)   # Flask constructor \n",
    "  \n",
    "# A decorator used to tell the application \n",
    "# which URL is associated function \n",
    "@app.route('/')       \n",
    "def hello(): \n",
    "    return 'HELLO'\n",
    "  \n",
    "if __name__=='__main__': \n",
    "   app.run(debug=True)"
   ]
